    "https://github.com/mcmaster-university",
    "https://ca.linkedin.com/school/mcmaster-university/"
  ],
  "developerPortal": "https://developer.api.mcmaster.ca/",
  "repository": {
    "@type": "Repository",
    "name": "MacSphere at McMaster University",
    "description": "DSpace 8.2 institutional repository of theses, dissertations, and open-access research outputs, exposed via a public OAI-PMH 2.0 metadata-harvesting interface.",
